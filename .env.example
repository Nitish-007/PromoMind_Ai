# ==============================================================================
# PromoMind AI — Environment Configuration Template
# Copy this file to .env and configure your variables
# ==============================================================================

# Application Port & Environment
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info

# Google Gemini API Key & Model Configuration
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# Google Cloud Platform Integration Settings (Phase 2 Roadmap)
# ------------------------------------------------------------------------------

# Google Cloud Project & Region
GCP_PROJECT_ID=promomind-ai-prod
GCP_REGION=asia-south1

# Google Vertex AI Configuration
VERTEX_AI_LOCATION=asia-south1
VERTEX_AI_MODEL_NAME=gemini-1.5-pro

# Google Cloud Storage (Bucket for raw CSV uploads & synced store_knowledge.md)
GCS_BUCKET_NAME=promomind-store-knowledge-vault

# Google Cloud Secret Manager (Optional: for fetching secrets in production)
USE_SECRET_MANAGER=false
SECRET_NAME_GEMINI_KEY=projects/promomind-ai-prod/secrets/gemini-api-key/versions/latest

# BigQuery Analytics Telemetry Dataset (Optional: for live retail POS event streams)
BIGQUERY_DATASET=promomind_telemetry
BIGQUERY_TABLE_TRANSACTIONS=kirana_pos_transactions

